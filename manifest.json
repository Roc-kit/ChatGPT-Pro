{
  "manifest_version": 3,
  "name": "ChatGPT Pro: The Ultimate AI Toolbox for ChatGPT",
  "version": "3.0.0",
  "description": "ChatGPT Pro 工具箱：支持聊天时间线、消息时间戳、来源筛选、搜索和 Markdown/JSON 批量导出。",

  "permissions": ["storage"],

  "homepage_url": "https://github.com/Roc-kit/ChatGPT-Pro",

  "host_permissions": [
    "https://chatgpt.com/*"
  ],

  "background": {
    "service_worker": "scripts/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["scripts/message-timestamp-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "scripts/api-handler.js",
        "scripts/content-chatgpt.js"
      ],
      "css": ["styles/timeline.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "ChatGPT Pro",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
